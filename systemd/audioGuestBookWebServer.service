[Unit]
Description=Rotary Phone Audio Guestbook Web Interface
After=network.target audioGuestBook.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rotary-phone-audio-guestbook
Environment=AGB_CONFIG_PATH=/opt/rotary-phone-audio-guestbook/config.yaml
ExecStart=/usr/bin/gunicorn --workers 1 --bind 0.0.0.0:8080 --chdir /opt/rotary-phone-audio-guestbook/webserver server:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
