[Unit]
Description=Rotary Phone Audio Guestbook
After=local-fs.target sound.target
Wants=sound.target

[Service]
Type=simple
WorkingDirectory=/opt/rotary-phone-audio-guestbook
ExecStart=/usr/bin/python3 /opt/rotary-phone-audio-guestbook/src/audioGuestBook.py
Restart=on-failure
RestartSec=3
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
